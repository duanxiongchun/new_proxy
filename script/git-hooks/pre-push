#!/usr/bin/env bash
# ==============================================================================
# new_proxy Git Pre-Push Hook
# ==============================================================================
# Redirect stdin to tty so that interactive commands (like sudo password prompt) work.
exec < /dev/tty

echo "======================================================================"
echo " Running Pre-Push Git Hook: AF_XDP QUIC v1 Gate"
echo "======================================================================"

if ! ./script/acceptance/run_acceptance.sh; then
  echo "❌ Push rejected: AF_XDP QUIC v1 gate failed!" >&2
  exit 1
fi

echo "✅ AF_XDP QUIC v1 gate passed. Pushing to git server..."
exit 0
